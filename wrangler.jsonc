{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "servigo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Toda navegación HTML y /api pasa por el Worker; /assets/* (con hash) se sirve directo. Ver 00 D8.
    "run_worker_first": ["/*", "!/assets/*"],
  },
  "vars": {
    "ROOT_DOMAIN": "localhost",
    "PLATFORM_SUBDOMAIN": "servigo",
    "SUPABASE_URL": "http://127.0.0.1:54421",
  },
  // Límites por IP de /api/bookings/* (fase 10). `period` solo admite 10 o 60 s.
  "ratelimits": [
    { "name": "BOOKING_CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "BOOKING_LOOKUP_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
  ],
  "observability": { "enabled": true },
  "env": {
    // Producción (fase 04). Se elige al compilar: `CLOUDFLARE_ENV=production pnpm build`
    // (con el plugin de Vite, `wrangler deploy` usa la config ya resuelta y no acepta `--env`).
    // El Worker se publica como `servigo-production`. `vars`, `routes` y `ratelimits` no se heredan.
    "production": {
      // Rutas más específicas de otros productos de Roquintech (y los Custom Domains) ganan sobre el comodín.
      "routes": [{ "pattern": "*.roquintech.com/*", "zone_name": "roquintech.com" }],
      "vars": {
        "ROOT_DOMAIN": "roquintech.com",
        "PLATFORM_SUBDOMAIN": "servigo",
        "SUPABASE_URL": "https://pkrwxmsqibjmmpzmswzm.supabase.co",
      },
      "ratelimits": [
        { "name": "BOOKING_CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "BOOKING_LOOKUP_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
      ],
      // Sin URL *.workers.dev: el Worker solo responde en roquintech.com.
      "workers_dev": false,
      "preview_urls": false,
    },
  },
}
