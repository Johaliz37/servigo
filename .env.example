# Variables del cliente (Vite). Copiar a `.env.local`.
# Valores locales: los imprime `pnpm db:start` (o `pnpm exec supabase status`).
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Site key de prueba de Turnstile que siempre valida (en producción la pone GitHub Actions).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
