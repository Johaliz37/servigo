{
  "ci": {
    "collect": {
      "url": ["http://demo.localhost:4274/", "http://demo.localhost:4274/s/norte"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 170,
          "throughputKbps": 9000,
          "requestLatencyMs": 637.5,
          "downloadThroughputKbps": 8100,
          "uploadThroughputKbps": 8100,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 153600, "aggregationMethod": "median" }],
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
